# Bluetooth
persist.bluetooth.bqr.event_mask=0x8000000E
persist.bluetooth.bqr.min_interval_ms=6000

# Display
sys.brightness.disable_gamma_conversion=true

# Netmgr
persist.data.df.agg.dl_pkt=10
persist.data.df.agg.dl_size=4096
persist.vendor.data.mode=concurrent

# Nothing Feature
ro.build.nothing.feature.base=0x600800001004458438124a040106b4247b97ffL
ro.build.nothing.feature.diff.device.Pong=0x24000003044002001aa4144ac04803d1842000L
